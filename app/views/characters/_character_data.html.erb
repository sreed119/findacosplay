<div class="card">
    <div class="card-content">
        <% if @character.image.attached? %>
            <%= image_tag @character.image, class: "data-img" %>
        <% end %>
        <h4><%= @character.name %> (<%= link_to "#{@character.medium.name}", medium_path(@character.medium) %>)</h4><br />
        <b>Hair Length: <%= @character.hair_length.capitalize %></b><br />
        <b>Hair Color: <%= @character.hair_color %></b><br />
        <b>Eye Color: <%= @character.eye_color %></b><br />
        <p>&nbsp;</p>
        <div class="action-button-group">
            <% if @is_saved %>
                <%= button_to user_character_path(@user_character), method: :delete, class: 'btn-floating waves-effect waves-light pink lighten-3' do %>
                    <i class="material-icons">bookmark</i>
                <% end %>
            <% elsif logged_in? %>
                <%= link_to new_user_character_path(character_id: @character.id), class: 'btn-floating waves-effect waves-light pink lighten-3' do %>
                    <i class="material-icons">bookmark_border</i>
                <% end %>
            <% end %>
            <% if controller.respond_to?(:update) && can?(:update, @character) %>
                <%= link_to edit_character_path(@character), class: 'btn-floating waves-effect waves-light pink lighten-3' do %>
                    <i class="material-icons left">mode_edit</i>
                <% end %>
            <% end %>
        </div>
    </div>
</div>
