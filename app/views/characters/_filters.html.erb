<div class="filter_bar">
  <%= form_with url: characters_path, method: :get, local: true, class: "search_filter_form" do %>
    <div class="filter_row search_row">
      <div class="search_wrapper">
        <%= text_field_tag :query,
            params[:query],
            placeholder: "Search characters...",
            class: "search_input" %>
      </div>
    </div>

    <div class="filter_row filter_dropdowns">
      <div class="filter_field">
        <%= label_tag :hair_length, "Hair Length" %>
        <%= select_tag :hair_length,
            options_for_select([
              ["Any hair length", ""],
              ["Short", "short"],
              ["Bob", "bob"],
              ["Medium", "medium"],
              ["Long", "long"],
              ["None", "none"]
            ], params[:hair_length]),
            include_blank: false,
            class: "browser-default filter_select",
            onchange: "this.form.submit()" %>
      </div>

      <div class="filter_field">
        <%= label_tag :hair_color, "Hair Color" %>
        <%= select_tag :hair_color,
            options_for_select([
              ["Any hair color", ""],
              ["Black", "Black"],
              ["Brown", "Brown"],
              ["Red", "Red"],
              ["Orange", "Orange"],
              ["Yellow", "Yellow"],
              ["Green", "Green"],
              ["Blue", "Blue"],
              ["Purple", "Purple"],
              ["Pink", "Pink"],
              ["White", "White"]
            ], params[:hair_color]),
            include_blank: false,
            class: "browser-default filter_select",
            onchange: "this.form.submit()" %>
      </div>

      <div class="filter_field">
        <%= label_tag :eye_color, "Eye Color" %>
        <%= select_tag :eye_color,
            options_for_select([
              ["Any eye color", ""],
              ["Black", "Black"],
              ["Brown", "Brown"],
              ["Red", "Red"],
              ["Orange", "Orange"],
              ["Yellow", "Yellow"],
              ["Green", "Green"],
              ["Blue", "Blue"],
              ["Purple", "Purple"],
              ["Pink", "Pink"],
              ["White", "White"]
            ], params[:eye_color]),
            include_blank: false,
            class: "browser-default filter_select",
            onchange: "this.form.submit()" %>
      </div>
    </div>
  <% end %>
</div>