<div class="row">
    <h4>Welcome to Find a Cosplay</h4>

    <div class="home_banner_carousel" aria-label="Featured cosplay banners">
      <div class="home_banner_track">
        <div class="home_banner_slide is-active">
          <%= image_tag "FCBanner1.png", alt: "Find a Cosplay banner 1" %>
        </div>
        <div class="home_banner_slide">
          <%= image_tag "FCBanner2.png", alt: "Find a Cosplay banner 2" %>
        </div>
        <div class="home_banner_slide">
          <%= image_tag "FCBanner3.png", alt: "Find a Cosplay banner 3" %>
        </div>
      </div>

      <div class="home_banner_controls" aria-label="Banner controls">
        <button type="button" class="home_banner_prev" aria-label="Previous banner">
          <i class="material-icons">chevron_left</i>
        </button>
        <button type="button" class="home_banner_next" aria-label="Next banner">
          <i class="material-icons">chevron_right</i>
        </button>
      </div>

      <div class="home_banner_dots" aria-label="Slide indicators">
        <button type="button" class="home_banner_dot is-active" aria-label="Show slide 1" data-slide="0"></button>
        <button type="button" class="home_banner_dot" aria-label="Show slide 2" data-slide="1"></button>
        <button type="button" class="home_banner_dot" aria-label="Show slide 3" data-slide="2"></button>
      </div>
    </div>

    <p>&nbsp;</p>
    <h4>Popular Items</h4>
    <% for user_item in @recents %>
      <div class="col s6 m4">
        <div class="card small">
          <div class="card-image list_card">
            <% if user_item.item.image.attached? && user_item.item.active %>
              <%= image_tag user_item.item.image, class: "list_img" %>
            <% elsif user_item.item.image.attached? %>
              <%= image_tag user_item.item.image, class: "list_img inactive-img" %>
            <% else %>
              <%= image_tag "photo_placeholder.jpg", class: "list_img" %>
            <% end %>
          </div>
          <div class="card-content">
            <% if user_item.item.active %>
              <span class="card-title"><%= link_to truncate(user_item.item.name, length: 22, omission: "..."), item_path(user_item.item) %></span>
            <% else %>
              <span class="card-title"><%= link_to "#{truncate(user_item.item.name, length: 11, omission: "...")} (Inactive)", item_path(user_item.item) %></span>
            <% end %>
            <p><%= link_to "#{user_item.item.store} ($#{user_item.item.price})", user_item.item.item_link, target: "_blank" %></p>
          </div>
        </div>
      </div>
    <% end %>
</div>
