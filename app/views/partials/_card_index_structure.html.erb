<div class="list_head">
    <% if not_save %>
        <div class="list_head_row">
            <h4><%= model_name.pluralize.capitalize %></h4>
            <% if logged_in? %>
                <%= render :partial => 'partials/add_new_object', locals: {model_name: model_name} %>
            <% end %>
        </div>
    <% end %>
    <% if filters %>
        <%= render partial: "#{filter_page}", locals: {model_name: model_name} %>
    <% end %>
</div>

<div>
    <!-- primary partial gets displayed here in main div -->
    <%= render partial: "#{primary}" %>
</div>
