<div class="card">
    <div class="card-content">
        <h4>All Users (<%= @count %>)
            <%= link_to(eval("new_user_path"), class: "btn-floating waves-effect waves-light pink lighten-3") do %>
                <i class="material-icons">add</i>
            <% end %>
        </h4>
        <p>Full user list is only available to site admin.</p>
        <ul class="collection">
            <% for user in @users %>
                <% if logged_in? && user.username == current_user.username %>
                    <li class="collection-item active blue lighten-1">
                        <div>
                            <%= link_to "#{user.username} (#{user.email})", user_path(user), class: "white-text" %>
                            <i class="material-icons secondary-content">star</i>
                        </div>
                    </li>
                <% else %>
                    <li class="collection-item">
                        <%= link_to "#{user.username} (#{user.email})", user_path(user) %>
                    </li>
                <% end %>
            <% end %>
        </ul>
    </div>
</div>
