<div class="card small">
    <div class="card-content" id="user_card">
        <h4><%= @user.username %></h4><br />
        <b>Email: <%= @user.email %></b><br />
        <p>&nbsp;</p>
        <% if controller.respond_to?(:update) && can?(:update, @user) %>
            <%= link_to edit_user_path(@user), class: 'btn-floating waves-effect waves-light pink lighten-3' do %>
                <i class="material-icons left">mode_edit</i>
            <% end %>
        <% end %>
    </div>
</div>
