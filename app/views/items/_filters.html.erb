<div class="filter_bar">
    <%= form_with url: items_path, method: :get, local: true, class: "search_wrapper_outer" do %>
    <div class="filter_row search_row">
        <div class="search_wrapper">
                <%= text_field_tag :query,
                    params[:query],
                    placeholder: "Search items...",
                    class: "search_input" %>
        </div>
    </div>

    <div class="filter_row filter_dropdowns">
        <div class="filter_field">
            <%= label_tag :category, "Item Type" %>
            <%= select_tag :category,
                options_for_select([
                    ["Any", ""],
                    ["Clothing", "clothing"],
                    ["Accessory", "accessory"],
                    ["Prop", "prop"],
                    ["Wig", "wig"],
                    ["Contacts", "contacts"],
                    ["Makeup", "makeup"],
                    ["Hat", "hat"]
                ], params[:category]),
                include_blank: false,
                class: "browser-default filter_select",
                onchange: "this.form.submit()" %>
        </div>

        <div class="filter_field">
            <%= label_tag :status, "Item Status" %>
            <%= select_tag :status,
                options_for_select([
                    ["All", ""],
                    ["Only In Stock Items", "active"]
                ], params[:status]),
                include_blank: false,
                class: "browser-default filter_select",
                onchange: "this.form.submit()" %>
        </div>
    </div>
    <% end %>
</div>