<div class="filter_bar">
    <%= form_with url: media_path, method: :get, local: true, class: "search_wrapper_outer" do %>
    <div class="filter_row search_row">
        <div class="search_wrapper">
                <%= text_field_tag :query,
                    params[:query],
                    placeholder: "Search media...",
                    class: "search_input"%>
        </div>
    </div>
    <div class="filter_row filter_dropdowns">
        <div class="filter_field">
            <%= label_tag :media_type, "Media Type" %>
            <%= select_tag :media_type,
                options_for_select([
                    ["Any", ""],
                    ["Animanga", "animanga"],
                    ["Game", "game"],
                    ["Cartoon", "cartoon"],
                    ["Movie", "movie"],
                    ["TV Show", "tv_show"]
                ], params[:media_type]),
                include_blank: false,
                class: "browser-default filter_select",
                onchange: "this.form.submit()" %>
        </div>
    </div>
    <% end %>
</div>