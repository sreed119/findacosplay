<div class="card">
    <div class="card-content">
        <% if @medium.image.attached? %>
            <%= image_tag @medium.image, class: "data-img" %>
        <% end %>
        <h4><%= @medium.name %></h4><br />
        <b>Media Type: <%= @medium.media_type.capitalize %></b><br />
        <p>&nbsp;</p>
        <div class="action-button-group">
            <% if @is_saved %>
                <%= button_to user_medium_path(@user_medium), method: :delete, params: { return_to: request.path }, class: 'btn-floating waves-effect waves-light pink lighten-3' do %>
                    <i class="material-icons">bookmark</i>
                <% end %>
            <% elsif logged_in? %>
                <%= button_to user_media_path, method: :post, params: { user_medium: { medium_id: @medium.id } }, class: 'btn-floating waves-effect waves-light pink lighten-3' do %>
                    <i class="material-icons">bookmark_border</i>
                <% end %>
            <% end %>
            <% if controller.respond_to?(:update) && can?(:update, @medium) %>
                <%= link_to edit_medium_path(@medium), class: 'btn-floating waves-effect waves-light pink lighten-3' do %>
                    <i class="material-icons left">mode_edit</i>
                <% end %>
            <% end %>
        </div>
    </div>
</div>
